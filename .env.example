# Template for local environment. Copy to .env.local and fill in real values.
# .env.local is git-ignored; never commit credentials.

# NestJS API base URL reachable from the dashboard server/container.
# Production should prefer an internal service URL, for example http://server:4000.
SERVER_URL=http://localhost:4000

# Legacy fallback for existing deployments. Prefer SERVER_URL for new builds.
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
