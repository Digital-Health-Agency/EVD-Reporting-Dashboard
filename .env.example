# Template for local environment. Copy to .env.local and fill in real values.
# .env.local is git-ignored; never commit credentials.

# Which data adapter the API routes use: "live" (ClickHouse) | "mock"
DATA_SOURCE=live

# ClickHouse Gold "marts" warehouse (HTTP interface, read via @clickhouse/client).
# The dashboard reads ONLY marts.* tables (+ stg_adam.screenings for POE for now).
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=marts
